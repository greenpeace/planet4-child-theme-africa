{% set socialLink = social.link ~ '?utm_medium=' ~ utm_medium ~ utm_content_param ~ utm_campaign_param %}
<div class="share-buttons">
	<div class="share-buttons-icons">
	<!-- Whatsapp -->
	<a href="https://wa.me/?text=Listen to this, from Greenpeace Africa!%0D%0D {{ (socialLink ~ '&utm_source=whatsapp')|url_encode }}"
		 onclick="dataLayer.push({'event' : 'uaevent', 'eventCategory' : 'Social Share', 'eventAction': 'Whatsapp', 'eventLabel': '{{ social.link }}'});"
		 target="_blank" rel="noopener" class="share-btn whatsapp">
		{{ 'whatsapp'|svgicon }}
		<span class="visually-hidden">{{ __( 'Share on', 'planet4-master-theme' ) }} Whatsapp</span>
	</a>
	<!-- Facebook -->
	<a href="https://www.facebook.com/sharer/sharer.php?u={{ (socialLink ~ '&utm_source=facebook')|url_encode }}&quote=Listen to this, from Greenpeace Africa!"
		 onclick="dataLayer.push({'event' : 'uaevent', 'eventCategory' : 'Social Share', 'eventAction': 'Facebook', 'eventLabel': '{{ social.link }}'});"
		 target="_blank" rel="noopener" class="share-btn facebook">
		{{ 'facebook-f'|svgicon }}
		<span class="visually-hidden">{{ __( 'Share on', 'planet4-master-theme' ) }} Facebook</span>
	</a>
	<!-- LinkedIn -->
	<a href="https://www.linkedin.com/sharing/share-offsite/?url={{ (socialLink ~ '&utm_source=linkedin')|url_encode }}"
		 onclick="dataLayer.push({'event' : 'uaevent', 'eventCategory' : 'Social Share', 'eventAction': 'LinkedIn', 'eventLabel': '{{ social.link }}'});"
		 target="_blank" rel="noopener" class="share-btn linkedin">
		{{ 'linkedin'|svgicon }}
		<span class="visually-hidden">{{ __( 'Share on', 'planet4-master-theme' ) }} LinkedIn</span>
	</a>
	<!-- Email -->
	<a href="mailto:?subject=Listen to this, from Greenpeace Africa!&body=Listen to this, from Greenpeace Africa! %0D%0D{% if social.description %}{{ social.description|striptags|url_encode }} {% endif %}{{ (socialLink ~ '&utm_source=email')|url_encode }}%0D%0D"
		 onclick="dataLayer.push({'event' : 'uaevent', 'eventCategory' : 'Social Share', 'eventAction': 'Email', 'eventLabel': '{{ social.link }}'});"
		 target="_blank" rel="noopener" class="share-btn email">
		{{ 'envelope'|svgicon }}
		<span class="visually-hidden">{{ __( 'Share via', 'planet4-master-theme' ) }} Email</span>
	</a>
	</div>
	<!-- Google preferred source -->
	{% if google_preferred_source %}
		<a
			aria-label="{{ __( 'Add as a preferred source on Google', 'planet4-master-theme' ) }}"
			class="google-preferred-source-link"
			href="https://google.com/preferences/source?q={{ google_preferred_source.domain }}"
			target="_blank"
			rel="noopener"
		>
			<img src="{{ google_preferred_source.image }}" alt="Google preferred source" />
			<span>{{ __( 'Add as a preferred source on Google', 'planet4-master-theme' ) }}</span>
		</a>
	{% endif %}
</div>
